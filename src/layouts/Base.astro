---
import '../styles/global.css';
import { ui, type Lang } from '../lib/i18n';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Caminho desta página, ex.: "/en/". */
  path: string;
  /** Caminho da mesma página no outro idioma. */
  altPath: string;
  ogType?: 'website' | 'article';
}

const { lang, title, description, path, altPath, ogType = 'website' } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'pt' ? 'en' : 'pt';
const site = Astro.site!;
const canonical = new URL(path, site).href;
const alternate = new URL(altPath, site).href;
const ogImage = new URL('/og.png', site).href;
const ptUrl = lang === 'pt' ? canonical : alternate;
const enUrl = lang === 'en' ? canonical : alternate;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href="/fonts/inter-tight-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile[lang].name} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={ptUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={ptUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#23252a" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile[lang].name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile[lang].name}, ${profile[lang].role}`} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={ui[other].ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{t.skip}</a>
    <div class="page">
      <slot />
      <footer class="site-footer meta">
        {profile[lang].name}, {new Date().getFullYear()}
      </footer>
    </div>
  </body>
</html>
