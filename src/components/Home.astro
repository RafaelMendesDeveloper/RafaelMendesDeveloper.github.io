---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LangSwitch from './LangSwitch.astro';
import DateRange from './DateRange.astro';
import photo from '../assets/rafael-mendes-pinto.png';
import { ui, type Lang } from '../lib/i18n';
import { contact, profile } from '../data/profile';
import { field, publications, pubPath } from '../lib/publications';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const p = profile[lang];
const s = t.sections;
const path = t.home;
const altPath = ui[lang === 'pt' ? 'en' : 'pt'].home;
const site = Astro.site!;

const nav = [
  ['experiencia', s.experience],
  ['publicacoes', s.publications],
  ['formacao', s.education],
  ['habilidades', s.skills],
  ['contato', s.contact],
] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: p.name,
  jobTitle: lang === 'pt' ? 'Engenheiro de Software' : 'Software Engineer',
  url: new URL(path, site).href,
  email: `mailto:${contact.email}`,
  sameAs: [contact.linkedin, contact.github],
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'Universidade Federal de Santa Catarina',
  },
  worksFor: { '@type': 'Organization', name: 'Wiipo' },
};
---

<Base lang={lang} title={`${p.name} · ${p.role.split(' · ')[0]}`} description={p.description} path={path} altPath={altPath}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <nav class="topbar" aria-label={t.nav}>
    <ul class="inline-list meta">
      {nav.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
    </ul>
    <LangSwitch lang={lang} altPath={altPath} />
  </nav>

  <header class="site-header">
    <div>
      <h1>{p.name}</h1>
      <p class="role">{p.role}</p>
      <ul class="inline-list header-links">
        <li><a href={`mailto:${contact.email}`}>E-mail</a></li>
        <li><a href={contact.linkedin}>LinkedIn</a></li>
        <li><a href={contact.github}>GitHub</a></li>
        <li>
          <a href={contact.cv} target="_blank" rel="noopener">
            {t.cv}<span class="sr-only"> {t.newTab}</span>
          </a>
        </li>
      </ul>
    </div>
    <Image
      class="photo"
      src={photo}
      alt={t.photoAlt}
      width={136}
      height={136}
      densities={[1, 2]}
      format="webp"
      loading="eager"
      fetchpriority="high"
    />
  </header>

  <main id="conteudo">
    <section class="about" aria-labelledby="sobre">
      <h2 id="sobre" class="sr-only">{s.about}</h2>
      <p>{p.about}</p>
    </section>

    <section class="section" aria-labelledby="experiencia">
      <h2 id="experiencia">{s.experience}</h2>
      {
        p.experience.map((job) => (
          <article class="entry">
            <div class="row">
              <h3>{job.company}</h3>
              <span class="meta">{job.location}</span>
            </div>
            <ul class="positions">
              {job.positions.map((pos) => (
                <li class="row">
                  <span>{pos.title}</span>
                  <span class="meta">
                    <DateRange lang={lang} start={pos.start} end={pos.end} />
                  </span>
                </li>
              ))}
            </ul>
            <ul class="bullets">
              {job.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <section class="section" aria-labelledby="publicacoes">
      <h2 id="publicacoes">{s.publications}</h2>
      <ul class="pub-list">
        {
          publications.map((pub) => {
            const page = pubPath(pub, lang);
            return (
              <li>
                <a class="pub-title" href={page} lang={pub.idioma === 'pt' ? 'pt-BR' : 'en'}>
                  {pub.titulo}
                </a>
                <p class="pub-ref">
                  {pub.autores.join(', ')}. {field.local(pub, lang)}. {field.status(pub, lang)},{' '}
                  {pub.ano}.
                </p>
                <ul class="pub-links meta">
                  <li>
                    <a href={pub.pdf} target="_blank" rel="noopener">
                      {t.pdf}
                      <span class="sr-only"> {t.newTab}</span>
                    </a>
                  </li>
                  <li>
                    <a href={`${page}#resumo`}>{t.abstractLink}</a>
                  </li>
                  {pub.citavel && (
                    <li>
                      <a href={`${page}#bibtex`}>{t.bibtex}</a>
                    </li>
                  )}
                  {pub.doi && (
                    <li>
                      <a href={`https://doi.org/${pub.doi}`}>{t.doi}</a>
                    </li>
                  )}
                </ul>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="formacao">
      <h2 id="formacao">{s.education}</h2>
      {
        p.education.map((d) => (
          <article class="entry">
            <div class="row">
              <h3>{d.title}</h3>
              <span class="meta">
                <DateRange lang={lang} start={d.start} end={d.end} />
              </span>
            </div>
            <div class="row">
              <span class="institution">{d.institution}</span>
              <span class="meta">{d.location}</span>
            </div>
            {d.focus && <p class="focus">{d.focus}</p>}
          </article>
        ))
      }
    </section>

    <section class="section" aria-labelledby="habilidades">
      <h2 id="habilidades">{s.skills}</h2>
      <dl class="skills">
        {
          p.skills.map((g) => (
            <>
              <dt>{g.label}</dt>
              <dd>{g.items}</dd>
            </>
          ))
        }
      </dl>
    </section>

    <section class="section contact" aria-labelledby="contato">
      <h2 id="contato">{s.contact}</h2>
      <dl>
        <dt>E-mail</dt>
        <dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
        <dt>LinkedIn</dt>
        <dd><a href={contact.linkedin}>{contact.linkedinLabel}</a></dd>
        <dt>GitHub</dt>
        <dd><a href={contact.github}>{contact.githubLabel}</a></dd>
        <dt>{lang === 'pt' ? 'Currículo' : 'CV'}</dt>
        <dd>
          <a href={contact.cv} target="_blank" rel="noopener">
            PDF{lang === 'en' ? ', Portuguese' : ''}<span class="sr-only"> {t.newTab}</span>
          </a>
        </dd>
      </dl>
    </section>
  </main>
</Base>
